# Dropbox_Photo_Sync configuration (do not commit real secrets)
#
# Preferred: OAuth refresh token + app credentials (best long-term)
DROPBOX_REFRESH_TOKEN=replace_me
DROPBOX_APP_KEY=replace_me
DROPBOX_APP_SECRET=replace_me
#
# Legacy: long-lived access token (works until revoked/expired)
DROPBOX_TOKEN=
#
# Folder to sync (must start with /)
DROPBOX_FOLDER=/Photos/PiFrame
#
# Where photos land on the Pi
LOCAL_PHOTO_DIR=/home/pi/pictures
#
# Sync loop timing and behavior
SYNC_LOOP_SECONDS=120
SYNC_DELETE_REMOVED=0
#
# Logging
LOG_LEVEL=INFO
LOG_FILE=/home/pi/Dropbox_Photo_Sync.log

