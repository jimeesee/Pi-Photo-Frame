[Unit]
Description=Pi Photo Frame Dropbox Sync
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=jimbo
WorkingDirectory=/home/jimbo/Pi_Photo_Frame
Environment=PYTHONUNBUFFERED=1
EnvironmentFile=/home/jimbo/Pi_Photo_Frame/.env
ExecStart=/home/jimbo/Pi_Photo_Frame/.venv/bin/python /home/jimbo/Pi_Photo_Frame/scripts/sync_dropbox.py
Restart=on-failure
RestartSec=10
StandardOutput=append:/home/jimbo/Pi_Photo_Frame/logs/sync.log
StandardError=append:/home/jimbo/Pi_Photo_Frame/logs/sync.log

[Install]
WantedBy=multi-user.target
