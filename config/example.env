# Dropbox configuration (required)
# Preferred (offline/long-term): OAuth refresh token + app credentials
DROPBOX_REFRESH_TOKEN=replace_me
DROPBOX_APP_KEY=replace_me
DROPBOX_APP_SECRET=replace_me
#
# Legacy: long-lived access token (works until revoked/expired)
DROPBOX_TOKEN=
DROPBOX_FOLDER=/Photos

# Viewer options (optional overrides)
SLIDESHOW_INTERVAL_SECONDS=15
IMAGE_EXTENSIONS=.jpg,.jpeg,.png,.gif

# Logging
LOG_LEVEL=INFO
